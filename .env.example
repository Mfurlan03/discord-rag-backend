# Retrieval backend: "memory" (default, indexes ./docs at startup, no DB needed)
#                 or "atlas"  (MongoDB Atlas Vector Search; run `python ingest.py` first)
RETRIEVER_BACKEND=memory
# For the memory backend: dense | bm25 | hybrid
RETRIEVAL_MODE=hybrid
DOCS_DIR=docs

# MongoDB Atlas (only for RETRIEVER_BACKEND=atlas)
MONGODB_URI=
MONGODB_DB=discord_rag
MONGODB_COLLECTION=chunks
ATLAS_VECTOR_INDEX=vector_index

# LLM: any OpenAI-compatible endpoint (DEEPSEEK_* names are also accepted)
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=deepseek/deepseek-chat

# RAG tuning
TOP_K=5
MIN_SCORE=0.25
MAX_TOKENS=500
MAX_CONTEXT_CHARS=6000
CHUNK_STRATEGY=fixed
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Discord
DISCORD_BOT_TOKEN=
RAG_API_URL=http://127.0.0.1:8000/api/rag-query
